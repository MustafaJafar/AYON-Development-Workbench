{
    // Two kinds of tasks. Most call a mani task (see mani.yaml), which is also what Claude runs via CLAUDE.md.
    // The others (launcher, services, live logs, ...) run directly in the VS Code terminal because they run until
    // you stop them or need a real terminal; they have no mani task.
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "Clone all repos",
            "type": "shell",
            "command": "mani sync && mani run submodules",
            "problemMatcher": []
        },
        {
            "label": "Clone a repo",
            "type": "shell",
            "command": "mani sync -p ${input:repo_name} --ignore-sync-state",
            "problemMatcher": []
        },
        {
            "label": "Status of all repos",
            "type": "shell",
            "command": "mani run status",
            "problemMatcher": []
        },
        {
            "label": "Update default branch in a repo",
            "type": "shell",
            "command": "mani run update-default -p ${input:repo_name}",
            "problemMatcher": []
        },
        {
            "label": "Update default branch in all repos",
            "type": "shell",
            "command": "mani run update-default",
            "problemMatcher": []
        },
        {
            "label": "Update default branch in essential repos",
            "type": "shell",
            "command": "mani run update-default --tags essential",
            "problemMatcher": []
        },
        {
            "label": "Update a repo to a branch",
            "type": "shell",
            "command": "mani run update-branch -p ${input:repo_name} BRANCH=${input:branch_name}",
            "problemMatcher": []
        },
        {
            "label": "Update a repo to a fork's branch",
            "type": "shell",
            "command": "mani run update-branch-remote -p ${input:repo_name} BRANCH=${input:fork_branch}",
            "problemMatcher": []
        },
        {
            "label": "Update Repo Submodules",
            "type": "shell",
            "command": "mani run submodules -p ${input:repo_name}",
            "problemMatcher": []
        },
        {
            "label": "Add remote to a repo",
            "type": "shell",
            "command": "mani run add-remote -p ${input:repo_name} REMOTE=${input:remote_name}",
            "problemMatcher": []
        },
        {
            "label": "Switch a repo to its most recent tag",
            "type": "shell",
            "command": "mani run tag-latest -p ${input:repo_name}",
            "problemMatcher": []
        },
        {
            "label": "Switch a repo to a tag",
            "type": "shell",
            "command": "mani run tag-checkout -p ${input:repo_name} TAG=${input:tag_num}",
            "problemMatcher": []
        },
        {
            "label": "Ruff Check",
            "type": "shell",
            "command": "mani run ruff-check -p ${input:repo_name} FILE=${input:file_name}",
            "problemMatcher": []
        },
        {
            "label": "Ruff Fix",
            "type": "shell",
            "command": "mani run ruff-fix -p ${input:repo_name} FILE=${input:file_name}",
            "problemMatcher": []
        },
        {
            "label": "Launch Jupyter",
            "type": "shell",
            "command": "jupyter notebook --notebook-dir tmp",
            "problemMatcher": []
        },
        {
            "label": "Create and upload an addon",
            "type": "shell",
            "command": "mani run addon-upload -p ${input:repo_name} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Create and upload all addons",
            "type": "shell",
            "command": "mani run addons-upload-all SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Clone AYON docker repo",
            "type": "shell",
            "command": "mani run docker-clone DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Update AYON Server",
            "type": "shell",
            "command": "mani run server-update DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Restart AYON Server",
            "type": "shell",
            "command": "mani run server-restart DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Rebuild AYON Server",
            "type": "shell",
            "command": "mani run server-rebuild DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Show AYON Server Log",
            "type": "shell",
            "command": "mani run server-log DOCKER_REPO=${input:docker_repo} SERVICE=${input:docker_service}",
            "problemMatcher": []
        },
        // Long-running: runs directly in the VS Code terminal (colours, Ctrl-C), not through mani.
        {
            "label": "Show Live AYON Server Log",
            "type": "shell",
            "command": "docker compose logs -f -t -n 10 ${input:docker_service}",
            "options": { "cwd": "${workspaceFolder}/${input:docker_repo}" },
            "problemMatcher": []
        },
        {
            "label": "Show AYON Server Release Info",
            "type": "shell",
            "command": "mani run server-release DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Prune Docker",
            "type": "shell",
            "command": "docker image prune -a",
            "problemMatcher": []
        },
        // I always have the frontend repo cloned in `<docker repo>/server`. Assumes you are already on the correct branch.
        {
            "label": "Run Live Frontend",
            "type": "shell",
            "command": "yarn install && yarn dev --host 0.0.0.0",
            "options": { "cwd": "${workspaceFolder}/${input:docker_repo}/server/ayon-frontend" },
            "problemMatcher": []
        },
        // `make` runs fine on Windows and on the Linux VM (no sudo needed). Rarely used, so no mani task for them.
        {
            "label": "Backup a Project",
            "type": "shell",
            "command": "make dump projectname=${input:project_name}",
            "options": { "cwd": "${workspaceFolder}/${input:docker_repo}" },
            "problemMatcher": []
        },
        {
            "label": "Import a Project",
            "type": "shell",
            "command": "make restore projectname=${input:project_name}",
            "options": { "cwd": "${workspaceFolder}/${input:docker_repo}" },
            "problemMatcher": []
        },
        {
            "label": "Update Kitsu Server",
            "type": "shell",
            "command": "mani run kitsu-update",
            "problemMatcher": []
        },
        {
            "label": "Initialize Docs",
            "type": "shell",
            "command": "mani run docs-init",
            "problemMatcher": []
        },
        {
            "label": "Run Docs",
            "type": "shell",
            "command": "mani run docs-run",
            "problemMatcher": []
        },
        {
            "label": "Make Docs Online",
            "type": "shell",
            "command": "ngrok http 3000",
            "problemMatcher": []
        },
        {
            "label": "Update Launcher env",
            "type": "shell",
            "command": "mani run launcher-env",
            "problemMatcher": []
        },
        {
            "label": "Build and Upload the launcher",
            "type": "shell",
            "command": "mani run launcher-build-upload SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        // Launcher (from code) and other single commands that run until you close them: direct VS Code tasks, so you get a real
        // terminal (colours, input). For a custom CA bundle add SSL_CERT_FILE and REQUESTS_CA_BUNDLE to a task's "options.env".
        {
            "label": "Run Live Launcher Production",
            "type": "shell",
            "command": "${workspaceFolder}/ayon-launcher/tools/ayon_console.bat",
            "problemMatcher": []
        },
        {
            "label": "Run Live Launcher Staging",
            "type": "shell",
            "command": "${workspaceFolder}/ayon-launcher/tools/ayon_console.bat",
            "args": ["--use-staging"],
            "problemMatcher": []
        },
        {
            "label": "Run Live Launcher Dev",
            "type": "shell",
            "command": "${workspaceFolder}/ayon-launcher/tools/ayon_console.bat",
            "args": ["--use-dev"],
            "problemMatcher": []
        },
        {
            "label": "Launch publish report viewer",
            "type": "shell",
            "command": "${workspaceFolder}/ayon-launcher/tools/ayon_console.bat",
            "args": ["--use-dev", "publish-report-viewer"],
            "problemMatcher": []
        },
        {
            "label": "Launch Tray Publisher in Dev",
            "type": "shell",
            "command": "${workspaceFolder}/ayon-launcher/tools/ayon_console.bat",
            "args": ["--use-dev", "addon", "traypublisher", "launch"],
            "problemMatcher": []
        },
        {
            "label": "Update ayon-core env",
            "type": "shell",
            "command": "mani run core-env",
            "problemMatcher": []
        },
        {
            "label": "Install dependencies tool",
            "type": "shell",
            "command": "mani run deptool-install",
            "problemMatcher": []
        },
        {
            "label": "Create & Upload dependency package",
            "type": "shell",
            "command": "mani run deptool-create-upload BUNDLE=${input:bundle_name} OUTPUT_DIR=${input:some_path} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Create dependency package",
            "type": "shell",
            "command": "mani run deptool-create BUNDLE=${input:bundle_name} OUTPUT_DIR=${input:some_path} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Install Shotgrid Services",
            "type": "shell",
            "command": "mani run shotgrid-install",
            "problemMatcher": []
        },
        // ShotGrid and ftrack services run from code. They run until you stop them, so they are direct VS Code tasks.
        // (The Kitsu processor below calls mani instead, because it has to read its addon version from package.py.)
        // For a custom CA bundle add SSL_CERT_FILE and REQUESTS_CA_BUNDLE to a task's "options.env".
        {
            "label": "Run Shotgrid Services",
            "type": "shell",
            "command": "pwsh ./manage.ps1 services",
            "options": {
                "cwd": "${workspaceFolder}/ayon-shotgrid/service_tools",
                "env": { "SHOTGUN_API_CACERTS": "${workspaceFolder}/ayon-shotgrid/service_tools/.venv/Lib/site-packages/shotgun_api3/lib/httplib2/cacerts.txt" }
            },
            "problemMatcher": []
        },
        {
            "label": "Run Shotgrid Leecher Service",
            "type": "shell",
            "command": "pwsh service_tools/manage.ps1 leecher --variant ${input:bundle_name}",
            "options": {
                "cwd": "${workspaceFolder}/ayon-shotgrid"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Shotgrid Processor Service",
            "type": "shell",
            "command": "pwsh service_tools/manage.ps1 processor --variant ${input:bundle_name}",
            "options": {
                "cwd": "${workspaceFolder}/ayon-shotgrid"
            },
            "problemMatcher": []
        },
        {
            "label": "Install ftrack Services",
            "type": "shell",
            "command": "mani run ftrack-install",
            "problemMatcher": []
        },
        {
            "label": "Run ftrack Services",
            "type": "shell",
            "command": "pwsh service_tools/manage.ps1 services --variant ${input:bundle_name}",
            "options": {
                "cwd": "${workspaceFolder}/ayon-ftrack"
            },
            "problemMatcher": []
        },
        {
            "label": "Run ftrack Leecher Service",
            "type": "shell",
            "command": "pwsh service_tools/manage.ps1 leecher --variant ${input:bundle_name}",
            "options": {
                "cwd": "${workspaceFolder}/ayon-ftrack"
            },
            "problemMatcher": []
        },
        {
            "label": "Run ftrack Processor Service",
            "type": "shell",
            "command": "pwsh service_tools/manage.ps1 processor --variant ${input:bundle_name}",
            "options": {
                "cwd": "${workspaceFolder}/ayon-ftrack"
            },
            "problemMatcher": []
        },
        {
            "label": "Install Kitsu Processor Service",
            "type": "shell",
            "command": "mani run kitsu-processor-install",
            "problemMatcher": []
        },
        {
            "label": "Run Kitsu Processor Service",
            "type": "shell",
            "command": "mani run kitsu-processor SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "fork_branch",
            "description": "<remote>:<branch>, as GitHub shows a PR from a fork (adds the remote if needed)",
            "default": "",
            "type": "promptString"
        },
        {
            "id": "ssl_cert",
            "description": "Optional: path to a CA bundle for a local SSL ayon-docker (SSL_CERT_FILE / REQUESTS_CA_BUNDLE). Leave empty if not needed.",
            "default": "",
            "type": "promptString"
        },
        {
            "id": "repo_name",
            "description": "",
            "default": "ayon-core",
            "type": "promptString"
        },
        {
            "id": "branch_name",
            "description": "Branch name on origin",
            "default": "develop",
            "type": "promptString"
        },
        {
            "id": "remote_name",
            "description": "",
            "default": "MustafaJafar",
            "type": "promptString"
        },
        {
            "id": "tag_num",
            "description": "",
            "default": "",
            "type": "promptString"
        },
        {
            "id": "docker_repo",
            "description": "",
            "default": "ayon-docker",
            "type": "promptString"
        },
        {
            "id": "docker_service",
            "description": "",
            "default": "server",
            "type": "promptString"
        },
        {
            "id": "project_name",
            "description": "",
            "default": "demo_Commercial",
            "type": "promptString"
        },
        {
            "id": "bundle_name",
            "description": "",
            "default": "AYON-Dev",
            "type": "promptString"
        },
        {
            "id": "some_path",
            "description": "",
            "default": "../tmp/packages",
            "type": "promptString"
        },
        {
            "id": "file_name",
            "description": "",
            "default": "",
            "type": "promptString"
        }
    ]
}
