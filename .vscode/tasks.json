{
    // Thin wrappers over mani tasks (see mani.yaml), the single source of truth, also used by Claude via CLAUDE.md.
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "Clone all repos",
            "type": "shell",
            "command": "mani sync && mani run submodules",
            "problemMatcher": []
        },
        {
            "label": "Clone a repo",
            "type": "shell",
            "command": "mani sync -p ${input:repo_name} --ignore-sync-state",
            "problemMatcher": []
        },
        {
            "label": "Status of all repos",
            "type": "shell",
            "command": "mani run status",
            "problemMatcher": []
        },
        {
            "label": "Update default branch in a repo",
            "type": "shell",
            "command": "mani run update-default -p ${input:repo_name}",
            "problemMatcher": []
        },
        {
            "label": "Update default branch in all repos",
            "type": "shell",
            "command": "mani run update-default",
            "problemMatcher": []
        },
        {
            "label": "Update default branch in essential repos",
            "type": "shell",
            "command": "mani run update-default --tags essential",
            "problemMatcher": []
        },
        {
            "label": "Update a repo to a branch",
            "type": "shell",
            "command": "mani run update-branch -p ${input:repo_name} BRANCH=${input:branch_name}",
            "problemMatcher": []
        },
        {
            "label": "Update Repo Submodules",
            "type": "shell",
            "command": "mani run submodules -p ${input:repo_name}",
            "problemMatcher": []
        },
        {
            "label": "Add remote to a repo",
            "type": "shell",
            "command": "mani run add-remote -p ${input:repo_name} REMOTE=${input:remote_name}",
            "problemMatcher": []
        },
        {
            "label": "Switch a repo to its most recent tag",
            "type": "shell",
            "command": "mani run tag-latest -p ${input:repo_name}",
            "problemMatcher": []
        },
        {
            "label": "Switch a repo to a tag",
            "type": "shell",
            "command": "mani run tag-checkout -p ${input:repo_name} TAG=${input:tag_num}",
            "problemMatcher": []
        },
        {
            "label": "Ruff Check",
            "type": "shell",
            "command": "mani run ruff-check -p ${input:repo_name} FILE=${input:file_name}",
            "problemMatcher": []
        },
        {
            "label": "Ruff Fix",
            "type": "shell",
            "command": "mani run ruff-fix -p ${input:repo_name} FILE=${input:file_name}",
            "problemMatcher": []
        },
        {
            "label": "Launch Jupyter",
            "type": "shell",
            "command": "mani run jupyter",
            "problemMatcher": []
        },
        {
            "label": "Create and upload an addon",
            "type": "shell",
            "command": "mani run addon-upload -p ${input:repo_name} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Create and upload all addons",
            "type": "shell",
            "command": "mani run addons-upload-all SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Clone AYON docker repo",
            "type": "shell",
            "command": "mani run docker-clone DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Update AYON Server",
            "type": "shell",
            "command": "mani run server-update DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Restart AYON Server",
            "type": "shell",
            "command": "mani run server-restart DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Rebuild AYON Server",
            "type": "shell",
            "command": "mani run server-rebuild DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Show AYON Server Log",
            "type": "shell",
            "command": "mani run server-log DOCKER_REPO=${input:docker_repo} SERVICE=${input:docker_service}",
            "problemMatcher": []
        },
        {
            "label": "Show Live AYON Server Log",
            "type": "shell",
            "command": "mani run server-log-live DOCKER_REPO=${input:docker_repo} SERVICE=${input:docker_service}",
            "problemMatcher": []
        },
        {
            "label": "Show AYON Server Release Info",
            "type": "shell",
            "command": "mani run server-release DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Prune Docker",
            "type": "shell",
            "command": "mani run server-prune",
            "problemMatcher": []
        },
        {
            "label": "Run Live Frontend",
            "type": "shell",
            "command": "mani run frontend-live DOCKER_REPO=${input:docker_repo}",
            "problemMatcher": []
        },
        {
            "label": "Backup a Project",
            "type": "shell",
            "command": "mani run project-backup DOCKER_REPO=${input:docker_repo} PROJECT=${input:project_name}",
            "problemMatcher": []
        },
        {
            "label": "Import a Project",
            "type": "shell",
            "command": "mani run project-restore DOCKER_REPO=${input:docker_repo} PROJECT=${input:project_name}",
            "problemMatcher": []
        },
        {
            "label": "Update Kitsu Server",
            "type": "shell",
            "command": "mani run kitsu-update",
            "problemMatcher": []
        },
        {
            "label": "Initialize Docs",
            "type": "shell",
            "command": "mani run docs-init",
            "problemMatcher": []
        },
        {
            "label": "Run Docs",
            "type": "shell",
            "command": "mani run docs-run",
            "problemMatcher": []
        },
        {
            "label": "Make Docs Online",
            "type": "shell",
            "command": "mani run docs-online",
            "problemMatcher": []
        },
        {
            "label": "Update Launcher env",
            "type": "shell",
            "command": "mani run launcher-env",
            "problemMatcher": []
        },
        {
            "label": "Build and Upload the launcher",
            "type": "shell",
            "command": "mani run launcher-build-upload SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Run Live Launcher Production",
            "type": "shell",
            "command": "mani run launcher-prod SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Run Live Launcher Staging",
            "type": "shell",
            "command": "mani run launcher-staging SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Run Live Launcher Dev",
            "type": "shell",
            "command": "mani run launcher-dev SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Launch publish report viewer",
            "type": "shell",
            "command": "mani run publish-report-viewer SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Launch Tray Publisher in Dev",
            "type": "shell",
            "command": "mani run traypublisher-dev SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Update ayon-core env",
            "type": "shell",
            "command": "mani run core-env",
            "problemMatcher": []
        },
        {
            "label": "Install dependencies tool",
            "type": "shell",
            "command": "mani run deptool-install",
            "problemMatcher": []
        },
        {
            "label": "Create & Upload dependency package",
            "type": "shell",
            "command": "mani run deptool-create-upload BUNDLE=${input:bundle_name} OUTPUT_DIR=${input:some_path} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Create dependency package",
            "type": "shell",
            "command": "mani run deptool-create BUNDLE=${input:bundle_name} OUTPUT_DIR=${input:some_path} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Install Shotgrid Services",
            "type": "shell",
            "command": "mani run shotgrid-install",
            "problemMatcher": []
        },
        {
            "label": "Run Shotgrid Services",
            "type": "shell",
            "command": "mani run shotgrid-services SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Run Shotgrid Leecher Service",
            "type": "shell",
            "command": "mani run shotgrid-leecher BUNDLE=${input:bundle_name} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Run Shotgrid Processor Service",
            "type": "shell",
            "command": "mani run shotgrid-processor BUNDLE=${input:bundle_name} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Install ftrack Services",
            "type": "shell",
            "command": "mani run ftrack-install",
            "problemMatcher": []
        },
        {
            "label": "Run ftrack Services",
            "type": "shell",
            "command": "mani run ftrack-services BUNDLE=${input:bundle_name} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Run ftrack Leecher Service",
            "type": "shell",
            "command": "mani run ftrack-leecher BUNDLE=${input:bundle_name} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Run ftrack Processor Service",
            "type": "shell",
            "command": "mani run ftrack-processor BUNDLE=${input:bundle_name} SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        {
            "label": "Install Kitsu Processor Service",
            "type": "shell",
            "command": "mani run kitsu-processor-install",
            "problemMatcher": []
        },
        {
            "label": "Run Kitsu Processor Service",
            "type": "shell",
            "command": "mani run kitsu-processor SSL_CERT=\"${input:ssl_cert}\"",
            "problemMatcher": []
        },
        // Linux VM only: make the Linux config the default mani.yaml, and undo it (run to-win before git pull).
        {
            "label": "Use Linux mani config (VM only)",
            "type": "shell",
            "command": "mani run to-linux",
            "problemMatcher": []
        },
        {
            "label": "Use Windows mani config again (VM only)",
            "type": "shell",
            "command": "mani run to-win",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "ssl_cert",
            "description": "Optional: path to a CA bundle for a local SSL ayon-docker (SSL_CERT_FILE / REQUESTS_CA_BUNDLE). Leave empty if not needed.",
            "default": "",
            "type": "promptString"
        },
        {
            "id": "repo_name",
            "description": "",
            "default": "ayon-core",
            "type": "promptString"
        },
        {
            "id": "branch_name",
            "description": "",
            "default": "develop",
            "type": "promptString"
        },
        {
            "id": "remote_name",
            "description": "",
            "default": "MustafaJafar",
            "type": "promptString"
        },
        {
            "id": "tag_num",
            "description": "",
            "default": "",
            "type": "promptString"
        },
        {
            "id": "docker_repo",
            "description": "",
            "default": "ayon-docker",
            "type": "promptString"
        },
        {
            "id": "docker_service",
            "description": "",
            "default": "server",
            "type": "promptString"
        },
        {
            "id": "project_name",
            "description": "",
            "default": "demo_Commercial",
            "type": "promptString"
        },
        {
            "id": "bundle_name",
            "description": "",
            "default": "AYON-Dev",
            "type": "promptString"
        },
        {
            "id": "some_path",
            "description": "",
            "default": "../tmp/packages",
            "type": "promptString"
        },
        {
            "id": "file_name",
            "description": "",
            "default": "",
            "type": "promptString"
        }
    ]
}
